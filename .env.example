# Supabase — client-side (safe to expose to browser)
# This is a Next.js project, so variables use the NEXT_PUBLIC_ prefix.
# These must be set in your Vercel project settings AND/OR local .env file.
#
# Required for Production (Vercel Project Settings → Environment Variables):
#   Set these for Production, Preview, and Development environments.
#   NEXT_PUBLIC_ variables are embedded at BUILD TIME, so a redeployment
#   is required after changing them.

NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# The Supabase URL must be the ROOT URL only:
#   ✅ https://yourproject.supabase.co
#   ❌ https://yourproject.supabase.co/rest/v1
#   ❌ https://yourproject.supabase.co/auth/v1
